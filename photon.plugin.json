{
  "manifestVersion": 1,
  "sdkVersion": 1,
  "id": "studio.photon.ai",
  "name": "Photon AI Studio",
  "version": "1.0.0",
  "main": "index.html",
  "panels": [
    {
      "id": "ai",
      "label": "AI",
      "ui": "custom",
      "minimumSize": {
        "width": 360,
        "height": 320
      }
    }
  ],
  "commands": [
    {
      "id": "generate",
      "label": "Generate Image\u2026",
      "scope": "app",
      "panel": "ai",
      "menu": "Image",
      "keywords": [
        "AI",
        "image generation"
      ]
    },
    {
      "id": "remove",
      "label": "AI Remove\u2026",
      "scope": "selection",
      "panel": "ai",
      "menu": "Edit",
      "contexts": [
        "selection"
      ],
      "keywords": [
        "erase",
        "remove object"
      ]
    },
    {
      "id": "fill",
      "label": "Generative Fill\u2026",
      "scope": "selection",
      "panel": "ai",
      "menu": "Edit",
      "contexts": [
        "selection"
      ],
      "keywords": [
        "inpaint",
        "AI fill"
      ]
    }
  ],
  "permissions": {
    "document": "readWrite",
    "credentials": true,
    "files": true,
    "customEndpoints": true,
    "network": [
      "https://api.openai.com",
      "https://generativelanguage.googleapis.com",
      "https://api.together.ai",
      "https://queue.fal.run",
      "https://api.replicate.com",
      "https://api.bfl.ai",
      "https://api.*.bfl.ai",
      "https://chatgpt.com",
      "https://auth.openai.com",
      "https://api.x.ai",
      "https://auth.x.ai",
      "https://*.x.ai",
      "https://cli-chat-proxy.grok.com",
      "https://api.ideogram.ai",
      "https://*.ideogram.ai"
    ],
    "credentialOrigins": {
      "https://api.bfl.ai": [
        "https://api.*.bfl.ai"
      ]
    }
  }
}
